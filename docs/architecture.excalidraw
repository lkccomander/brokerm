      "updated": 1774848085998,
      "link": null,
      "locked": false,
      "text": "Source Layer\n\nmain.tsx boots React\nApp.tsx defines BrowserRouter\npages/: Landing, Catalog, SiteMap\ncomponents/: shared UI sections\ndata/mockData.ts supplies site copy + listings\ncontent/editableContent.ts overrides key metrics\npublic/images + icons.svg provide static media",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Source Layer\n\nmain.tsx boots React\nApp.tsx defines BrowserRouter\npages/: Landing, Catalog, SiteMap\ncomponents/: shared UI sections\ndata/mockData.ts supplies site copy + listings\ncontent/editableContent.ts overrides key metrics\npublic/images + icons.svg provide static media",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 212,
      "index": "a5"
    },
