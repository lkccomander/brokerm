      "updated": 1774848085998,
      "link": null,
      "locked": false,
      "text": "Runtime / Delivery Layer\n\nDocker multi-stage image\nNode 22 builds app\nCaddy serves /dist as static site\nSPA fallback via try_files -> /index.html\nSecurity headers + gzip/zstd\n/health endpoint for platform checks\nClient-side navigation handled in browser",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Runtime / Delivery Layer\n\nDocker multi-stage image\nNode 22 builds app\nCaddy serves /dist as static site\nSPA fallback via try_files -> /index.html\nSecurity headers + gzip/zstd\n/health endpoint for platform checks\nClient-side navigation handled in browser",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 188,
      "index": "a9"
    },
