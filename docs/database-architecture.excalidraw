      "text": "properties\n\nPK id\nslug UNIQUE\ntitle\ndescription\nproperty_type\nbusiness_type\nstatus\nprice_usd\nprice_crc nullable\nbedrooms\nbathrooms\nparking_spaces\nconstruction_m2\nlot_m2\nprovince\ncanton\ndistrict\naddress_display\nlat\nlng\nfeatured\npublished_at nullable\ncreated_at\nupdated_at\n\nOptional FKs in normalized version:\nlocation_id\nagent_id",
